# Replace each matching string recursively; preserve all non-human values and JSON ordering.
def walk(v):
 if isinstance(v,dict):
  for k,x in v.items():
   if k=='lang': v[k]='es'
   else: v[k]=walk(x)
  return v
 if isinstance(v,list): return [walk(x) for x in v]
 if isinstance(v,str): return T.get(v,v)
 return v
