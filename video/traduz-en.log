def convert(x):
    if isinstance(x, dict):
        return {k: ('en' if k == 'lang' else convert(v)) for k,v in x.items()}
    if isinstance(x, list): return [convert(v) for v in x]
    if isinstance(x,str): return T.get(x,x)
    return x
